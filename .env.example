# --- Core Flask & Database ---
APP_ENV=production
PORT=8080
SECRET_KEY=genera_una_clave_hexadecimal_aleatoria_de_64_caracteres
DATABASE_URL=postgresql+psycopg2://beerfinder:password_segura@/beerfinder?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# --- Bootstrap Opcional de Cuenta Admin Inicial ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia_esta_password_en_secret_manager

# --- Google Cloud Storage (Recomendado en GCP Cloud Run vía ADC) ---
GCS_PUBLIC_BUCKET=beermap-media-public
GCS_PRIVATE_BUCKET=beermap-claims-private
PUBLIC_CDN_URL=

# --- Android TWA / Google Play (Digital Asset Links en /.well-known/assetlinks.json) ---
ANDROID_PACKAGE_NAME=app.beermap.twa
ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...

# --- Email Transaccional (OTP de cuenta y verificación por dominio corporativo) ---
# Valores soportados: resend | smtp | dev_console
MAIL_PROVIDER=resend
MAIL_FROM="BeerMap <verificacion@tudominio.com>"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Alternativa SMTP (si MAIL_PROVIDER=smtp)
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_USER=verificacion@tudominio.com
SMTP_PASSWORD=tu_password_smtp
SMTP_USE_TLS=1
